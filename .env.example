# Trackers
NCORE_BASE_URL=https://ncore.pro
NCORE_USERNAME=
NCORE_COOKIE_PASS=
APIBAY_BASE_URL=https://apibay.org

# Metadata
TMDB_ACCESS_TOKEN=

# Database (matches the `db` service in docker-compose.yml)
DATABASE_URL=postgres://movieapp:movieapp@db:5432/movieapp

# Encrypts secrets saved on the Settings page. Without it, secrets can only be set here.
# Generate one with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# Passkeys: the host name the app is opened on, and its full origin(s), comma-separated
RP_ID=localhost
RP_ORIGIN=http://localhost:8085
# Host names the frontend answers to (comma-separated)
NG_ALLOWED_HOSTS=localhost

# Optional integrations (all of these can also be set on the Settings page)
QBITTORRENT_URL=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
DOWNLOAD_PATH_MOVIES=/media/Movies
DOWNLOAD_PATH_TV=/media/TV_Shows
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
OPENAI_API_KEY=
GITHUB_REPO=misomarcell/release-manager
GITHUB_TOKEN=

# Schedules (cron, server time zone)
QBITTORRENT_CRON=0 6 * * *
JELLYFIN_CRON=0 6 * * *
WATCHLIST_CRON=0 9 * * *
