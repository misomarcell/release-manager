{
  "name": "release-manager-workspace",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "start": "pnpm --filter web start",
    "start:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter shared build && pnpm --filter backend build && pnpm --filter web build",
    "lint": "pnpm -r lint",
    "knip": "pnpm -r knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm build && pnpm knip",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "lint-staged": {
    "*.{ts,html}": "eslint",
    "*": "prettier --write --ignore-unknown"
  }
}
