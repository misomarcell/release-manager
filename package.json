{
  "name": "release-manager-workspace",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "start": "pnpm --filter web start",
    "start:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter shared build && pnpm --filter backend build && pnpm --filter web build",
    "lint": "pnpm -r lint",
    "knip": "pnpm -r knip",
    "validate": "pnpm lint && pnpm build && pnpm knip",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.66.0"
  },
  "lint-staged": {
    "*.{ts,html}": "eslint"
  }
}
